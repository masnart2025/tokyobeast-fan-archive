---
import { getCollection } from "astro:content";
import CompletionModal from "../components/CompletionModal.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TOKYOBEAST FAN ARCHIVE",
  description = "TOKYOBEASTについての公式情報、考察、二次創作設定、同人作品をまとめた個人ファンアーカイブ。",
} = Astro.props;

const articles = await getCollection(
  "articles",
  ({ data }) => data.draft === false
);

const articleIds = articles.map((article) => article.id);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">

        <a href="/" class="logo">
          <span class="logo-main">TOKYOBEAST</span>
          <span class="logo-sub">FAN ARCHIVE</span>
        </a>

<nav class="main-nav" aria-label="メインナビゲーション">
  <a href="/">HOME</a>
  <a href="/world/">WORLD</a>
  <a href="/meta/">META</a>
  <a href="/characters/">CHARACTERS</a>
  <a href="/works/">FAN WORKS</a>
  <a href="/about/">ABOUT</a>
</nav>

      </div>
    </header>

    <CompletionModal
      totalArticles={articleIds.length}
      articleIds={articleIds}
    />

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <strong>TOKYOBEAST FAN ARCHIVE</strong>
        <p>Unofficial Fan Archive / Research / Fan Works</p>
      </div>

<div class="footer-links">
  <a href="/">HOME</a>
  <a href="/world/">WORLD</a>
  <a href="/meta/">META</a>
  <a href="/characters/">CHARACTERS</a>
  <a href="/works/">FAN WORKS</a>
  <a href="/about/">ABOUT</a>
</div>

      <p class="copyright">
        This is an unofficial fan archive.
      </p>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #080a0f;
    color: #e8edf5;
    font-family:
      Inter,
      "Noto Sans JP",
      "Yu Gothic",
      "Hiragino Kaku Gothic ProN",
      sans-serif;
    line-height: 1.7;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(8, 10, 15, 0.94);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 16px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .logo {
    display: flex;
    flex-direction: column;
    line-height: 1;
    flex-shrink: 0;
  }

  .logo-main {
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .logo-sub {
    margin-top: 5px;
    font-size: 9px;
    letter-spacing: 0.28em;
    opacity: 0.55;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .main-nav a {
    opacity: 0.65;
    transition: opacity 0.2s, transform 0.2s;
  }

  .main-nav a:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  .site-footer {
    max-width: 1280px;
    margin: 0 auto;
    padding: 45px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #7f8998;
  }

  .site-footer strong {
    color: #dbe2eb;
    font-size: 12px;
    letter-spacing: 0.1em;
  }

  .site-footer p {
    margin: 5px 0 0;
    font-size: 10px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .footer-links a:hover {
    color: #69e7ff;
  }

  .copyright {
    text-align: right;
  }

  @media (max-width: 700px) {
    .header-inner {
      padding: 14px 18px;
    }

    .main-nav {
      display: none;
    }

    .site-footer {
      flex-direction: column;
      align-items: flex-start;
      padding: 35px 20px;
    }

    .copyright {
      text-align: left;
    }
  }
</style>