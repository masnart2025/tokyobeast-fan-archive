---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const works = await getCollection(
  "articles",
  ({ data }) =>
    data.category === "fan-works" &&
    data.draft === false
);

works.sort((a, b) => {
  const dateA = a.data.date
    ? a.data.date.getTime()
    : 0;

  const dateB = b.data.date
    ? b.data.date.getTime()
    : 0;

  return dateB - dateA;
});
---

<BaseLayout
  title="FAN WORKS | TOKYOBEAST FAN ARCHIVE"
  description="TOKYOBEASTを題材に制作した同人誌・同人ゲームなどの作品を紹介するアーカイブ。"
>

  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">FAN WORKS ARCHIVE</p>
      <h1>同人作品</h1>
      <p>
        TOKYOBEASTを題材に制作した同人誌・同人ゲームなど、
        自分が制作した作品をまとめています。
      </p>
    </div>
  </section>

  <main class="archive-page">

    <section class="intro">
      <span class="badge">DOUJIN</span>

      <h2>FAN WORKS</h2>

      <p>
        作品そのものだけでなく、
        制作のきっかけになった考察や設定、
        登場するキャラクターなども整理していきます。
      </p>
    </section>

<section class="works-section">

  <div class="works-heading">
    <span>WORKS</span>
    <div>
      <p>FAN WORKS ARCHIVE</p>
      <h2>作品一覧</h2>
    </div>
  </div>

  {
    works.length > 0 ? (
      <div class="works-grid">

        {works.map((work) => (
          <a
            href={`/articles/${work.id}/`}
            class="work-card"
          >

            <div class="work-card-meta">

              <span
                class={`work-level level-${work.data.level}`}
              >
                {work.data.level.toUpperCase()}
              </span>

              <span class="work-topics">
                {work.data.topics.join(" / ").toUpperCase()}
              </span>

            </div>

            <h3>
              {work.data.title}
            </h3>

            <p>
              {work.data.description}
            </p>

            <span class="work-card-arrow">
              READ WORK →
            </span>

          </a>
        ))}

      </div>
    ) : (
      <div class="empty">
        <span>ARCHIVE UNDER CONSTRUCTION</span>
        <h2>作品情報を準備中です</h2>
        <p>
          今後、制作した同人作品を順次追加していきます。
        </p>
      </div>
    )
  }

</section>

    <a href="/" class="back-link">
      ← HOMEへ戻る
    </a>

  </main>

</BaseLayout>

<style>
  .page-hero {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background:
      radial-gradient(
        circle at 75% 45%,
        rgba(255, 189, 115, 0.1),
        transparent 35%
      ),
      #080a0f;
  }

  .page-hero-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 100px 40px 90px;
  }

  .eyebrow {
    margin: 0;
    color: #69e7ff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.25em;
  }

  h1 {
    margin: 18px 0 20px;
    font-size: clamp(42px, 7vw, 78px);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .page-hero-inner > p:last-child {
    max-width: 650px;
    margin: 0;
    color: #aeb6c4;
    font-size: 16px;
  }

  .archive-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 90px 40px 120px;
  }

  .intro {
    max-width: 720px;
  }

  .badge {
    display: inline-flex;
    padding: 4px 8px;
    border: 1px solid #ffbd73;
    color: #ffbd73;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .intro h2 {
    margin: 22px 0 12px;
    font-size: 32px;
  }

  .intro p {
    margin: 0;
    color: #9da7b5;
  }

  .empty {
    margin-top: 70px;
    padding: 60px 30px;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .empty > span {
    color: #69e7ff;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.2em;
  }

  .empty h2 {
    margin: 16px 0 8px;
    font-size: 24px;
  }

  .empty p {
    margin: 0;
    color: #8993a2;
    font-size: 12px;
  }

/* ==============================
   WORKS
============================== */

.works-section {
  margin-top: 80px;
}

.works-heading {
  display: flex;
  gap: 18px;
  margin-bottom: 35px;
}

.works-heading > span {
  color: #ffbd73;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .15em;
}

.works-heading p {
  margin: 0;

  color: #ffbd73;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: .15em;
}

.works-heading h2 {
  margin: 5px 0 0;

  font-size: 30px;
  line-height: 1.1;
}


.works-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 12px;
}


.work-card {
  display: block;

  padding: 28px;

  border: 1px solid rgba(255,255,255,.1);

  background: rgba(255,255,255,.025);

  color: inherit;
  text-decoration: none;

  transition:
    border-color .2s ease,
    background .2s ease,
    transform .2s ease;
}


.work-card:hover {
  border-color: rgba(255,189,115,.45);

  background: rgba(255,189,115,.035);

  transform: translateY(-3px);
}


.work-card-meta {
  display: flex;

  align-items: center;

  gap: 8px;

  margin-bottom: 20px;
}


.work-level {
  padding: 4px 6px;

  border: 1px solid currentColor;

  font-size: 8px;

  font-weight: 900;

  letter-spacing: .1em;
}


.level-official {
  color: #69e7ff;
}

.level-inference {
  color: #9ca8ff;
}

.level-theory {
  color: #c89aff;
}

.level-fanon {
  color: #ff9fcf;
}

.level-doujin {
  color: #ffbd73;
}


.work-topics {
  color: #586970;

  font-size: 8px;

  letter-spacing: .08em;
}


.work-card h3 {
  margin: 0;

  font-size: 21px;

  line-height: 1.4;
}


.work-card p {
  margin: 10px 0 0;

  color: #8993a2;

  font-size: 12px;

  line-height: 1.7;
}


.work-card-arrow {
  display: inline-block;

  margin-top: 24px;

  color: #ffbd73;

  font-size: 9px;

  font-weight: 800;

  letter-spacing: .1em;
}


@media (max-width: 700px) {

  .works-grid {
    grid-template-columns: 1fr;
  }

  .work-card {
    padding: 24px;
  }

}

  .back-link {
    display: inline-block;
    margin-top: 45px;
    color: #69e7ff;
    font-size: 12px;
    font-weight: 800;
  }

  @media (max-width: 700px) {
    .page-hero-inner {
      padding: 75px 20px;
    }

    .archive-page {
      padding: 70px 20px 90px;
    }
  }
</style>