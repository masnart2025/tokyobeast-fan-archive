---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="CHARACTERS | TOKYOBEAST FAN ARCHIVE"
  description="TOKYOBEASTの公式キャラクターと、同人作品に登場する二次創作キャラクターを整理するアーカイブ。"
>

  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">CHARACTER ARCHIVE</p>
      <h1>キャラクター</h1>
      <p>
        TOKYOBEASTに登場するキャラクターと、
        同人作品の中で生まれた二次創作キャラクターを整理しています。
      </p>
    </div>
  </section>

  <main class="archive-page">

    <section class="intro">
      <span class="badge">CHARACTERS</span>

      <h2>キャラクターアーカイブ</h2>

      <p>
        公式キャラクターと二次創作キャラクターを区別し、
        それぞれの設定や登場作品などを整理していきます。
      </p>
    </section>

    <section class="character-grid">

      <a href="#" class="character-card official">
        <span class="badge">OFFICIAL</span>

        <h2>公式キャラクター</h2>

        <p>
          TOKYOBEAST公式作品に登場するキャラクターを
          整理します。
        </p>

        <span class="card-arrow">→</span>
      </a>

      <a href="#" class="character-card doujin">
        <span class="badge">DOUJIN</span>

        <h2>同人キャラクター</h2>

        <p>
          同人作品の中で生まれた
          二次創作キャラクターを整理します。
        </p>

        <span class="card-arrow">→</span>
      </a>

    </section>

    <section class="empty">
      <span>ARCHIVE UNDER CONSTRUCTION</span>
      <h2>キャラクター情報を準備中です</h2>
      <p>
        今後、キャラクターごとのページを順次追加していきます。
      </p>
    </section>

    <a href="/" class="back-link">
      ← HOMEへ戻る
    </a>

  </main>

</BaseLayout>

<style>
  .page-hero {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background:
      radial-gradient(
        circle at 75% 45%,
        rgba(142, 229, 187, 0.1),
        transparent 35%
      ),
      #080a0f;
  }

  .page-hero-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 100px 40px 90px;
  }

  .eyebrow {
    margin: 0;
    color: #69e7ff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.25em;
  }

  h1 {
    margin: 18px 0 20px;
    font-size: clamp(42px, 7vw, 78px);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .page-hero-inner > p:last-child {
    max-width: 700px;
    margin: 0;
    color: #aeb6c4;
    font-size: 16px;
  }

  .archive-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 90px 40px 120px;
  }

  .intro {
    max-width: 720px;
  }

  .badge {
    display: inline-flex;
    width: fit-content;
    padding: 4px 8px;
    border: 1px solid currentColor;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .intro > .badge {
    color: #69e7ff;
  }

  .intro h2 {
    margin: 22px 0 12px;
    font-size: 32px;
  }

  .intro p {
    margin: 0;
    color: #9da7b5;
  }

  .character-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 70px;
  }

  .character-card {
    position: relative;
    min-height: 300px;
    padding: 35px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #0d1119;
    transition: 0.2s;
  }

  .character-card:hover {
    transform: translateY(-4px);
    border-color: rgba(105, 231, 255, 0.45);
  }

  .character-card.official .badge {
    color: #69e7ff;
  }

  .character-card.doujin .badge {
    color: #ffbd73;
  }

  .character-card h2 {
    margin: 25px 0 12px;
    font-size: 28px;
  }

  .character-card p {
    max-width: 500px;
    color: #9da7b5;
  }

  .card-arrow {
    position: absolute;
    right: 30px;
    bottom: 25px;
    color: #69e7ff;
    font-size: 22px;
  }

  .empty {
    margin-top: 70px;
    padding: 60px 30px;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .empty > span {
    color: #69e7ff;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.2em;
  }

  .empty h2 {
    margin: 16px 0 8px;
    font-size: 24px;
  }

  .empty p {
    margin: 0;
    color: #8993a2;
    font-size: 12px;
  }

  .back-link {
    display: inline-block;
    margin-top: 45px;
    color: #69e7ff;
    font-size: 12px;
    font-weight: 800;
  }

  @media (max-width: 700px) {
    .page-hero-inner {
      padding: 75px 20px;
    }

    .archive-page {
      padding: 70px 20px 90px;
    }

    .character-grid {
      grid-template-columns: 1fr;
    }
  }
</style>