---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleReadTracker from "../../components/ArticleReadTracker.astro";
import NextRecommendation from "../../components/NextRecommendation.astro";
import WorkViewer from "../../components/WorkViewer.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  return articles
    .filter((article) => !article.data.draft)
    .map((article) => ({
      params: {
        slug: article.id,
      },
      props: {
        article,
      },
    }));
}

const { article } = Astro.props;

const allArticles = await getCollection("articles");

const articleMap = new Map(
  allArticles
    .filter((item) => !item.data.draft)
    .map((item) => [item.data.articleId, item])
);

const { Content } = await render(article);

const levelLabels = {
  official: "OFFICIAL",
  inference: "INFERENCE",
  theory: "THEORY",
  fanon: "FANON",
  doujin: "DOUJIN",
};

const categoryLabels = {
  world: "WORLD",
  meta: "META",
  characters: "CHARACTERS",
  "fan-works": "FAN WORKS",
};
const levelLabel = levelLabels[article.data.level];
const categoryLabel = categoryLabels[article.data.category];
---

<BaseLayout
  pageTitle={`${article.data.title} | TOKYOBEAST FAN ARCHIVE`}
  description={article.data.description}
>
  <main>

    <!-- ARTICLE HEADER -->

    <header class="article-header">

      <div class="article-header-inner">

        <div class="breadcrumbs">
          <a href="/">HOME</a>
          <span>/</span>
          <a href={`/${article.data.category}/`}>
            {categoryLabel}
          </a>
          <span>/</span>
          <span>{article.data.topics.join(" / ").toUpperCase()}</span>
        </div>


        <div class="article-meta">

          <span class="category-badge">
            {categoryLabel}
          </span>

          <span class={`level-badge level-${article.data.level}`}>
            {levelLabel}
          </span>

        </div>


        <h1>{article.data.title}</h1>

        <p class="description">
          {article.data.description}
        </p>


        <div class="tags">

          {
            article.data.tags.map((tag) => (
              <span>#{tag}</span>
            ))
          }

        </div>

      </div>

    </header>


    <!-- ARTICLE BODY -->

<article class="article-body">

  <Content />

</article>

{
  article.data.viewer && (
    <WorkViewer viewer={article.data.viewer} />
  )
}

<ArticleReadTracker articleId={article.data.articleId} />


    <!-- SOURCE -->

{
  article.data.source.length > 0 && (
    <section class="article-info">

      <h2>SOURCE</h2>

      <ul>
        {
          article.data.source.map((source) => {
            const isUrl = /^https?:\/\//.test(source);

            return (
              <li>
                {isUrl ? (
                  <a
                    href={source}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {source}
                  </a>
                ) : (
                  source
                )}
              </li>
            );
          })
        }
      </ul>

    </section>
  )
}


    <!-- REFERENCE -->

    {
      article.data.reference.length > 0 && (
        <section class="article-info">

          <h2>REFERENCE</h2>

<ul>
  {
    article.data.reference.map((reference) => {
      const target = articleMap.get(reference);

      return (
        <li>
          {target ? (
            <a href={`/articles/${target.id}/`}>
              {target.data.title}
            </a>
          ) : (
            reference
          )}
        </li>
      );
    })
  }
</ul>

        </section>
      )
    }


<NextRecommendation
  articles={allArticles
    .filter((item) => !item.data.draft)
    .map((item) => ({
      articleId: item.data.articleId,
      title: item.data.title,
      description: item.data.description,
      category: item.data.category,
      topics: item.data.topics,
      level: item.data.level,
      slug: item.id,
    }))}
  currentArticleId={article.data.articleId}
/>
  </main>
</BaseLayout>


<style>

  main {
    min-height: 100vh;
  }


  /* ------------------------------
     HEADER
  ------------------------------ */

  .article-header {
    padding: 90px 24px 80px;

    border-bottom: 1px solid rgba(84, 223, 255, 0.15);

    background:
      linear-gradient(
        rgba(84, 223, 255, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(84, 223, 255, 0.025) 1px,
        transparent 1px
      );

    background-size: 40px 40px;
  }


  .article-header-inner {
    max-width: 900px;
    margin: 0 auto;
  }


  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;

    margin-bottom: 35px;

    color: #56666d;

    font-size: 10px;
    letter-spacing: 0.08em;
  }


  .breadcrumbs a {
    color: #54dfff;
    text-decoration: none;
  }


  .article-meta {
    display: flex;
    gap: 8px;

    margin-bottom: 25px;
  }


  .category-badge,
  .level-badge {
    padding: 7px 10px;

    border: 1px solid rgba(255, 255, 255, 0.12);

    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }


  .category-badge {
    color: #a7b5bb;
  }


.level-badge {
  border-color: currentColor;
  background: rgba(255, 255, 255, 0.02);
}

/* HOME INFORMATION LEVEL と同じカラー */

.level-badge.level-official {
  color: #69e7ff;
  border-color: #69e7ff;
  background: rgba(105, 231, 255, 0.05);
}

.level-badge.level-inference {
  color: #9ca8ff;
  border-color: #9ca8ff;
  background: rgba(156, 168, 255, 0.05);
}

.level-badge.level-theory {
  color: #c89aff;
  border-color: #c89aff;
  background: rgba(200, 154, 255, 0.05);
}

.level-badge.level-fanon {
  color: #ff9fcf;
  border-color: #ff9fcf;
  background: rgba(255, 159, 207, 0.05);
}

.level-badge.level-doujin {
  color: #ffbd73;
  border-color: #ffbd73;
  background: rgba(255, 189, 115, 0.05);
}


  .article-header h1 {
    margin: 0;

    font-size: clamp(40px, 7vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }


  .description {
    max-width: 700px;

    margin: 28px 0 0;

    color: #9caab0;

    font-size: 16px;
    line-height: 1.8;
  }


  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;

    margin-top: 25px;
  }


  .tags span {
    padding: 5px 8px;

    border: 1px solid rgba(255, 255, 255, 0.08);

    color: #7f8e94;

    font-size: 10px;
  }


  /* ------------------------------
     ARTICLE
  ------------------------------ */

  .article-body {
    max-width: 760px;

    margin: 0 auto;
    padding: 80px 24px;
  }


  .article-body :global(h2) {
    margin-top: 70px;
    margin-bottom: 20px;

    padding-bottom: 10px;

    border-bottom: 1px solid rgba(255, 255, 255, 0.08);

    font-size: 28px;
  }


  .article-body :global(h3) {
    margin-top: 45px;

    font-size: 20px;
  }


  .article-body :global(p) {
    color: #b1bdc2;

    line-height: 2;
  }


  .article-body :global(a) {
    color: #54dfff;
  }


  .article-body :global(blockquote) {
    margin: 30px 0;
    padding: 20px;

    border-left: 2px solid #54dfff;

    background: rgba(84, 223, 255, 0.025);

    color: #aab7bc;
  }

.article-body :global(img) {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto;
  margin: 2.5rem auto;
  object-fit: contain;
}

.image-credit {
  display: flex;
  align-items: center;
  gap: 8px;

  color: #66757c;
  font-size: 10px;
  letter-spacing: 0.08em;
}

.image-credit-label {
  padding: 4px 7px;

  border: 1px solid rgba(255, 255, 255, 0.15);

  color: #54dfff;

  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.image-credit-name {
  color: #87969c;
  font-size: 10px;
}

.article-info a {
  color: #54dfff;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.article-info a:hover {
  opacity: 0.7;
}

  /* ------------------------------
     INFORMATION
  ------------------------------ */

  .article-info {
    max-width: 760px;

    margin: 0 auto;

    padding: 30px 24px;

    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }


  .article-info h2 {
    margin: 0 0 20px;

    color: #54dfff;

    font-size: 11px;
    letter-spacing: 0.15em;
  }


  .article-info ul {
    margin: 0;
    padding-left: 20px;

    color: #87969c;

    line-height: 1.9;
  }

</style>