---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  type?: "official" | "unofficial";
  credit?: string;
}

const {
  src,
  alt,
  caption = "",
  type = "unofficial",
  credit = "",
} = Astro.props;
---

<figure class="article-image">
  <img class="article-image-main" src={src} alt={alt} />

  {caption && (
    <figcaption class="article-image-caption">
      {caption}
    </figcaption>
  )}

  <div class="article-image-credit">
    <span class="article-image-credit-badge">
      {type === "official" ? "OFFICIAL" : "NON-OFFICIAL"}
    </span>

    {credit && (
      <span class="article-image-credit-name">
        {credit}
      </span>
    )}
  </div>
</figure>

<style>
  .article-image {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 2.5rem auto;
    padding: 0;
    text-align: center;
  }

  .article-image-main {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 720px;
    height: auto;
    margin: 0 auto;
    object-fit: contain;
  }

  .article-image-caption {
    display: block;
    width: 100%;
    margin: 12px 0 0;
    padding: 0;
    color: #7f8d93;
    font-size: 11px;
    line-height: 1.7;
    text-align: center;
  }

  .article-image-credit {
    display: flex;
    width: 100%;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin: 10px 0 0;
    padding: 0;
    color: #718087;
    font-size: 9px;
    line-height: 1.5;
    text-align: center;
    letter-spacing: 0.08em;
  }

  .article-image-credit-badge {
    display: inline-block;
    padding: 3px 6px;
    border: 1px solid rgba(84, 223, 255, 0.35);
    color: #54dfff;
    font-size: 8px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .article-image-credit-name {
    display: inline-block;
    color: #87969c;
    font-size: 9px;
    line-height: 1.5;
    white-space: nowrap;
  }
</style>