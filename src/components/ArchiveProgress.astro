---
interface Props {
  totalArticles: number;
  articleIds: string[];
}

const { totalArticles, articleIds } = Astro.props;
---

<section
  class="archive-progress"
  data-archive-progress
  data-total={totalArticles}
  data-article-ids={JSON.stringify(articleIds)}
>
  <div class="progress-header">
    <div>
      <p class="eyebrow">ARCHIVE PROGRESS</p>
      <h2>READING STATUS</h2>
    </div>

    <div class="progress-percent" data-progress-percent>
      0%
    </div>
  </div>

  <div class="progress-count">
    <span data-read-count>0</span>
    <span class="separator">/</span>
    <span data-total-count>{totalArticles}</span>
    <span class="label">ARTICLES READ</span>
  </div>

  <div class="progress-bar">
    <div
      class="progress-bar-fill"
      data-progress-bar
      style="width: 0%"
    ></div>
  </div>

  <div class="progress-footer">
    <span>ARCHIVE COMPLETION</span>
    <span data-progress-status>IN PROGRESS</span>
  </div>
</section>

<style>
  .archive-progress {
    position: relative;
    margin: 3rem 0;
    padding: 2rem;
    border: 1px solid rgba(0, 229, 255, 0.25);
    background:
      linear-gradient(
        135deg,
        rgba(0, 229, 255, 0.06),
        rgba(0, 0, 0, 0.2)
      );
    overflow: hidden;
  }

  .archive-progress::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 35%;
    height: 1px;
    background: #00e5ff;
  }

  .progress-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  .eyebrow {
    margin: 0 0 0.4rem;
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    color: #00e5ff;
  }

  h2 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  .progress-percent {
    font-size: 2rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #00e5ff;
  }

  .progress-count {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-top: 2rem;
  }

  .progress-count [data-read-count],
  .progress-count [data-total-count] {
    font-size: 1.6rem;
    font-weight: 700;
  }

  .progress-count .separator {
    color: #555;
  }

  .progress-count .label {
    margin-left: 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: #888;
  }

  .progress-bar {
    position: relative;
    width: 100%;
    height: 6px;
    margin-top: 1.2rem;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    background: #00e5ff;
    transition:
      width 0.5s ease;
  }

  .progress-footer {
    display: flex;
    justify-content: space-between;
    margin-top: 0.8rem;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: #666;
  }

  [data-progress-status] {
    color: #00e5ff;
  }

  .archive-progress.is-complete {
    border-color: rgba(0, 229, 255, 0.6);
  }

  .archive-progress.is-complete .progress-bar-fill {
    box-shadow:
      0 0 10px rgba(0, 229, 255, 0.5);
  }

  @media (max-width: 600px) {
    .archive-progress {
      padding: 1.4rem;
    }

    .progress-percent {
      font-size: 1.5rem;
    }

    .progress-count .label {
      font-size: 0.6rem;
    }
  }
</style>

<script is:inline>
  (() => {
    const STORAGE_KEY = "tokyobeast-read-articles-v1";
    const COMPLETION_KEY = "tokyobeast-archive-completion-v1";

    const progress =
      document.querySelector("[data-archive-progress]");

    if (!progress) return;

    const total =
      Number(progress.getAttribute("data-total")) || 0;

    const articleIdsRaw =
      progress.getAttribute("data-article-ids") || "[]";

    let articleIds = [];

    try {
      articleIds = JSON.parse(articleIdsRaw);
    } catch {
      articleIds = [];
    }

    const completionSignature =
      articleIds.slice().sort().join("|");

    const readCountElement =
      progress.querySelector("[data-read-count]");

    const totalCountElement =
      progress.querySelector("[data-total-count]");

    const percentElement =
      progress.querySelector("[data-progress-percent]");

    const progressBar =
      progress.querySelector("[data-progress-bar]");

    const statusElement =
      progress.querySelector("[data-progress-status]");

    if (totalCountElement) {
      totalCountElement.textContent =
        String(total);
    }

    function getReadArticles() {
      try {
        const saved =
          localStorage.getItem(STORAGE_KEY);

        if (!saved) return [];

        const parsed = JSON.parse(saved);

        if (!Array.isArray(parsed)) {
          return [];
        }

        return parsed;
      } catch {
        return [];
      }
    }

    function celebrateCompletion() {
      try {
        const celebrated =
          localStorage.getItem(COMPLETION_KEY);

        // 同じ記事構成では一度だけ祝う。
        // 新しい記事が追加されて全記事数が変われば、
        // 新しいシグネチャになるので再び祝える。
        if (celebrated === completionSignature) {
          return;
        }

        localStorage.setItem(
          COMPLETION_KEY,
          completionSignature
        );
      } catch {
        // localStorageが使えない場合でも演出自体は試みる
      }

      window.dispatchEvent(
        new CustomEvent("tokyobeast:archive-complete", {
          detail: {
            articleIds,
            total,
          },
        })
      );
    }

    function updateProgress() {
      const savedArticles =
        getReadArticles();

      // 現在公開されている記事だけを対象にする
      const validReadArticles =
        savedArticles.filter((id) =>
          articleIds.includes(id)
        );

      const readCount =
        validReadArticles.length;

      const percentage =
        total > 0
          ? Math.round((readCount / total) * 100)
          : 0;

      if (readCountElement) {
        readCountElement.textContent =
          String(readCount);
      }

      if (percentElement) {
        percentElement.textContent =
          `${percentage}%`;
      }

      if (progressBar) {
        progressBar.style.width =
          `${percentage}%`;
      }

      if (statusElement) {
        if (percentage >= 100 && total > 0) {
          statusElement.textContent =
            "ARCHIVE COMPLETE";
          progress.classList.add("is-complete");

          celebrateCompletion();
        } else {
          statusElement.textContent =
            "IN PROGRESS";
          progress.classList.remove("is-complete");
        }
      }
    }

    // 初回表示
    updateProgress();

    // 同じページ内で読了した場合
    window.addEventListener(
      "tokyobeast:article-read",
      updateProgress
    );

    // 別タブで読了した場合
    window.addEventListener(
      "storage",
      (event) => {
        if (event.key === STORAGE_KEY) {
          updateProgress();
        }
      }
    );
  })();
</script>
