---
interface Article {
  articleId: string;
  title: string;
  description: string;
  category: string;
  topics: string[];
  level: string;
  slug: string;
}

interface Props {
  articles: Article[];
  currentArticleId?: string;
}

const { articles, currentArticleId = "" } = Astro.props;
---

<section
  class="recommendation"
  data-recommendation
  data-articles={JSON.stringify(articles)}
  data-current-article-id={currentArticleId}
>
  <div class="recommendation-header">
    <div>
      <p class="eyebrow">NEXT RECOMMENDATION</p>
      <h2>次に読むなら、これ。</h2>
    </div>

    <span class="recommendation-mark">03</span>
  </div>

  <div class="recommendation-list">

    <!-- SAME TOPIC -->
<a
  href="#"
  class="recommendation-card"
  data-recommendation-card="same-topic"
  data-recommendation-link
>
  <div class="recommendation-info">
    <p class="recommendation-meta">
      SAME TOPIC
    </p>

    <h3 data-recommendation-title>-</h3>

    <p
      class="recommendation-description"
      data-recommendation-description
    >
      -
    </p>
  </div>

  <span class="recommendation-button">
    READ ARTICLE →
  </span>
</a>


    <!-- SAME CATEGORY -->
<a
  href="#"
  class="recommendation-card"
  data-recommendation-card="same-category"
  data-recommendation-link
>
  <div class="recommendation-info">
    <p class="recommendation-meta">
      SAME CATEGORY
    </p>

    <h3 data-recommendation-title>-</h3>

    <p
      class="recommendation-description"
      data-recommendation-description
    >
      -
    </p>
  </div>

  <span class="recommendation-button">
    READ ARTICLE →
  </span>
</a>


    <!-- RANDOM -->
<a
  href="#"
  class="recommendation-card"
  data-recommendation-card="random"
  data-recommendation-link
>
  <div class="recommendation-info">
    <p class="recommendation-meta">
      RANDOM
    </p>

    <h3 data-recommendation-title>-</h3>

    <p
      class="recommendation-description"
      data-recommendation-description
    >
      -
    </p>
  </div>

  <span class="recommendation-button">
    READ ARTICLE →
  </span>
</a>

  </div>


  <div
    class="recommendation-complete"
    data-recommendation-complete
  >
    <span class="complete-mark">✓</span>

    <p>ARCHIVE COMPLETE</p>

    <small>
      すべての記事を読了しました。
    </small>
  </div>
</section>


<style>
  .recommendation {
    margin-top: 2rem;
  }

  .recommendation-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .eyebrow {
    margin: 0;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: #69e7ff;
  }

  .recommendation-header h2 {
    margin: 0.4rem 0 0;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  .recommendation-mark {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: #4f5966;
  }

  .recommendation-list {
    display: grid;
    gap: 0.8rem;
  }

.recommendation-card {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 2rem;
  padding: 1.4rem 1.6rem;

  border: 1px solid rgba(105, 231, 255, 0.22);

  background:
    linear-gradient(
      135deg,
      rgba(105, 231, 255, 0.045),
      rgba(255, 255, 255, 0.012)
    );

  color: inherit;
  text-decoration: none;
  cursor: pointer;

  transition:
    border-color 0.2s,
    background 0.2s;
}

  .recommendation-card:hover {
    border-color: rgba(105, 231, 255, 0.5);

    background:
      linear-gradient(
        135deg,
        rgba(105, 231, 255, 0.08),
        rgba(255, 255, 255, 0.025)
      );
  }

  .recommendation-meta {
    margin: 0;

    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.1em;

    color: #69e7ff;
  }

  .recommendation-info h3 {
    margin: 0.55rem 0 0;
    font-size: 1.2rem;
  }

  .recommendation-description {
    max-width: 650px;

    margin: 0.6rem 0 0;

    color: #929cab;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .recommendation-button {
    flex-shrink: 0;

    padding: 0.7rem 1rem;

    border: 1px solid #69e7ff;

    color: #69e7ff;

    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;

    text-decoration: none;

    transition:
      background 0.2s,
      color 0.2s;
  }

  .recommendation-button:hover {
    background: #69e7ff;
    color: #071016;
  }

  .recommendation-complete {
    display: none;

    padding: 2rem;

    text-align: center;

    border: 1px solid rgba(0, 229, 255, 0.45);

    background:
      radial-gradient(
        circle at center,
        rgba(0, 229, 255, 0.08),
        transparent 65%
      );
  }

  .recommendation-complete.is-visible {
    display: block;
  }

  .complete-mark {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    width: 2rem;
    height: 2rem;

    border: 1px solid #00e5ff;
    border-radius: 50%;

    color: #00e5ff;
  }

  .recommendation-complete p {
    margin: 0.9rem 0 0;

    color: #00e5ff;

    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  .recommendation-complete small {
    display: block;

    margin-top: 0.4rem;

    color: #7e8794;
  }

  @media (max-width: 700px) {
    .recommendation-card {
      flex-direction: column;
      align-items: flex-start;
    }

    .recommendation-button {
      width: 100%;
      text-align: center;
    }
  }
</style>


<script is:inline>
  (() => {
    const STORAGE_KEY =
      "tokyobeast-read-articles-v1";

    const root =
      document.querySelector(
        "[data-recommendation]"
      );

    if (!root) return;


    const rawArticles =
      root.getAttribute(
        "data-articles"
      ) || "[]";

    let articles = [];

    try {
      articles = JSON.parse(
        rawArticles
      );
    } catch {
      articles = [];
    }


    const currentArticleId =
      root.getAttribute(
        "data-current-article-id"
      ) || "";


    function getReadArticles() {
      try {
        const saved =
          localStorage.getItem(
            STORAGE_KEY
          );

        if (!saved) return [];

        const parsed =
          JSON.parse(saved);

        return Array.isArray(parsed)
          ? parsed
          : [];
      } catch {
        return [];
      }
    }


    function randomItem(items) {
      if (!items.length) {
        return null;
      }

      return items[
        Math.floor(
          Math.random() *
          items.length
        )
      ];
    }


    function getCard(type) {
      return root.querySelector(
        `[data-recommendation-card="${type}"]`
      );
    }


function setCard(card, article) {
  if (!card || !article) {
    return;
  }

  const title =
    card.querySelector(
      "[data-recommendation-title]"
    );

  const description =
    card.querySelector(
      "[data-recommendation-description]"
    );

  if (title) {
    title.textContent =
      article.title;
  }

  if (description) {
    description.textContent =
      article.description;
  }

  card.href =
    `/articles/${article.slug}/`;

  card.style.display = "";
}


    function hideCard(card) {
      if (!card) return;

      card.style.display = "none";
    }


    function chooseRecommendations() {

      const readArticles =
        getReadArticles();


      /*
       * 未読記事だけを候補にする。
       * 現在の記事自身も除外する。
       */
      const unreadArticles =
        articles.filter(
          (article) =>
            !readArticles.includes(
              article.articleId
            ) &&
            article.articleId !==
              currentArticleId
        );


      const complete =
        root.querySelector(
          "[data-recommendation-complete]"
        );


      if (
        unreadArticles.length === 0
      ) {
        root
          .querySelector(
            ".recommendation-list"
          )
          ?.setAttribute(
            "style",
            "display:none;"
          );

        complete?.classList.add(
          "is-visible"
        );

        return;
      }


      complete?.classList.remove(
        "is-visible"
      );


      /*
       * 現在の記事
       */
      const currentArticle =
        articles.find(
          (article) =>
            article.articleId ===
            currentArticleId
        ) || null;


      /*
       * すでに選択された記事
       */
      const selected =
        new Set();


      /*
       * ------------------------------
       * ① SAME TOPIC
       * ------------------------------
       *
       * TOPICSは複数。
       * 1つでも共通していれば候補。
       */
      let sameTopic = [];

      if (currentArticle) {
        sameTopic =
          unreadArticles.filter(
            (article) =>
              article.category ===
                currentArticle.category &&
              article.topics.some(
                (topic) =>
                  currentArticle.topics.includes(
                    topic
                  )
              )
          );
      }


      const sameTopicArticle =
        randomItem(
          sameTopic
        );


      if (sameTopicArticle) {
        selected.add(
          sameTopicArticle.articleId
        );

        setCard(
          getCard("same-topic"),
          sameTopicArticle
        );
      } else {
        hideCard(
          getCard("same-topic")
        );
      }


      /*
       * ------------------------------
       * ② SAME CATEGORY
       * ------------------------------
       *
       * 同じCATEGORYだが、
       * TOPICは1つも重ならない記事。
       */
      let sameCategory = [];

      if (currentArticle) {
        sameCategory =
          unreadArticles.filter(
            (article) =>
              article.category ===
                currentArticle.category &&
              !article.topics.some(
                (topic) =>
                  currentArticle.topics.includes(
                    topic
                  )
              ) &&
              !selected.has(
                article.articleId
              )
          );
      }


      const sameCategoryArticle =
        randomItem(
          sameCategory
        );


      if (sameCategoryArticle) {
        selected.add(
          sameCategoryArticle.articleId
        );

        setCard(
          getCard("same-category"),
          sameCategoryArticle
        );
      } else {
        hideCard(
          getCard("same-category")
        );
      }


      /*
       * ------------------------------
       * ③ RANDOM
       * ------------------------------
       */
      const randomCandidates =
        unreadArticles.filter(
          (article) =>
            !selected.has(
              article.articleId
            )
        );


      const randomArticle =
        randomItem(
          randomCandidates
        );


      if (randomArticle) {
        setCard(
          getCard("random"),
          randomArticle
        );
      } else {
        hideCard(
          getCard("random")
        );
      }
    }


    chooseRecommendations();


    window.addEventListener(
      "tokyobeast:article-read",
      chooseRecommendations
    );


    window.addEventListener(
      "storage",
      (event) => {
        if (
          event.key === STORAGE_KEY
        ) {
          chooseRecommendations();
        }
      }
    );
  })();
</script>