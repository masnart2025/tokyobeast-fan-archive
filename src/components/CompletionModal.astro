---
interface Props {
  totalArticles: number;
  articleIds: string[];
}

const { totalArticles, articleIds } = Astro.props;
---

<div
  class="completion-modal"
  data-completion-modal
  data-total={totalArticles}
  data-article-ids={JSON.stringify(articleIds)}
  aria-hidden="true"
>
  <div
    class="completion-backdrop"
    data-completion-close
  ></div>

  <section
    class="completion-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="completion-title"
    tabindex="-1"
  >
    <button
      class="completion-close"
      type="button"
      data-completion-close
      aria-label="閉じる"
    >
      ×
    </button>

    <p class="completion-eyebrow">ARCHIVE COMPLETE</p>

    <h2 id="completion-title">
      COMPLETE!
    </h2>

    <div class="completion-image-wrap">
      <img
        data-completion-image
        data-src="/images/archive-complete.webp"
        alt="COMPLETE! 全記事読了を祝うビーストたち"
        width="1254"
        height="1254"
      />
    </div>

    <p class="completion-message">
      すべての記事を読み終えました！<br />
      ありがとうございました！
    </p>

    <button
      class="completion-button"
      type="button"
      data-completion-close
    >
      CLOSE
    </button>
  </section>
</div>

<style>
  .completion-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1rem;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
  }

  .completion-modal.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .completion-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.78);
    backdrop-filter: blur(5px);
  }

  .completion-dialog {
    position: relative;
    width: min(92vw, 620px);
    max-height: 92vh;
    overflow-y: auto;
    padding: 2rem 2rem 2.2rem;
    text-align: center;
    border: 1px solid rgba(0, 229, 255, 0.45);
    background:
      linear-gradient(
        145deg,
        rgba(18, 25, 32, 0.98),
        rgba(4, 8, 12, 0.98)
      );
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.03),
      0 20px 80px rgba(0, 0, 0, 0.55),
      0 0 40px rgba(0, 229, 255, 0.12);
    transform: scale(0.92) translateY(12px);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .completion-modal.is-open .completion-dialog {
    transform: scale(1) translateY(0);
  }

  .completion-close {
    position: absolute;
    top: 0.6rem;
    right: 0.7rem;
    z-index: 2;
    width: 2.2rem;
    height: 2.2rem;
    border: 0;
    background: transparent;
    color: #aaa;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
  }

  .completion-close:hover {
    color: #fff;
  }

  .completion-eyebrow {
    margin: 0;
    color: #00e5ff;
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    font-weight: 700;
  }

  .completion-dialog h2 {
    margin: 0.3rem 0 0.8rem;
    font-size: clamp(2rem, 7vw, 3.4rem);
    line-height: 1;
    letter-spacing: 0.06em;
    color: #fff;
    text-shadow:
      0 0 14px rgba(0, 229, 255, 0.22);
  }

  .completion-image-wrap {
    width: min(100%, 460px);
    margin: 0 auto;
    overflow: hidden;
    border-radius: 0.8rem;
  }

  .completion-image-wrap img {
    display: block;
    width: 100%;
    height: auto;
  }

  .completion-message {
    margin: 1.3rem 0 1.4rem;
    color: #ddd;
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .completion-button {
    min-width: 140px;
    padding: 0.7rem 1.5rem;
    border: 1px solid rgba(0, 229, 255, 0.55);
    background: rgba(0, 229, 255, 0.08);
    color: #00e5ff;
    font: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    font-weight: 700;
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .completion-button:hover {
    background: rgba(0, 229, 255, 0.16);
    border-color: #00e5ff;
  }

  @media (max-width: 600px) {
    .completion-dialog {
      padding: 1.5rem 1rem 1.6rem;
    }

    .completion-image-wrap {
      width: min(100%, 380px);
    }

    .completion-message {
      font-size: 0.85rem;
    }
  }
</style>

<script is:inline>
  (() => {
    const STORAGE_KEY = "tokyobeast-read-articles-v1";
    const COMPLETION_KEY = "tokyobeast-archive-completion-v1";

    const modal =
      document.querySelector("[data-completion-modal]");

    if (!modal) return;

    const dialog =
      modal.querySelector(".completion-dialog");

    const image =
      modal.querySelector("[data-completion-image]");

    const total =
      Number(modal.getAttribute("data-total")) || 0;

    const articleIdsRaw =
      modal.getAttribute("data-article-ids") || "[]";

    let articleIds = [];

    try {
      articleIds = JSON.parse(articleIdsRaw);
    } catch {
      articleIds = [];
    }

    let lastFocusedElement = null;
    let completed = false;

    function getReadArticles() {
      try {
        const saved =
          localStorage.getItem(STORAGE_KEY);

        if (!saved) return [];

        const parsed = JSON.parse(saved);

        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    }

function getCompletionSignature() {
  return String(total);
}

    function openModal() {
      lastFocusedElement =
        document.activeElement;

      if (image && !image.getAttribute("src")) {
        const src =
          image.getAttribute("data-src");

        if (src) {
          image.setAttribute("src", src);
        }
      }

      modal.classList.add("is-open");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";

      requestAnimationFrame(() => {
        dialog?.focus();
      });
    }

    function closeModal() {
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";

      if (
        lastFocusedElement &&
        typeof lastFocusedElement.focus === "function"
      ) {
        lastFocusedElement.focus();
      }
    }

function checkCompletion(readArticles) {
  // 現在存在する記事だけを対象にする。
  // 過去に削除・改名された記事IDは無視する。
  const validReadArticles = [
    ...new Set(
      readArticles.filter((id) =>
        articleIds.includes(id)
      )
    ),
  ];

  const isComplete =
    total > 0 &&
    validReadArticles.length >= total;

  if (!isComplete || completed) {
    return;
  }

  completed = true;

  // 「記事IDの一覧」ではなく、
  // 「何記事構成でCOMPLETEしたか」だけを保存する。
  const completionSignature = String(total);

  let alreadyCelebrated = false;

  try {
    alreadyCelebrated =
      localStorage.getItem(COMPLETION_KEY) ===
      completionSignature;
  } catch {
    alreadyCelebrated = false;
  }

  if (alreadyCelebrated) {
    return;
  }

  try {
    localStorage.setItem(
      COMPLETION_KEY,
      completionSignature
    );
  } catch {
    // localStorage が利用できない場合でも表示を試みる
  }

  openModal();
}

    modal
      .querySelectorAll("[data-completion-close]")
      .forEach((button) => {
        button.addEventListener("click", closeModal);
      });

    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        modal.classList.contains("is-open")
      ) {
        closeModal();
      }
    });

    // ArticleReadTracker が発生させるイベントを、
    // 記事ページの内容より先に監視しておく。
window.addEventListener(
  "tokyobeast:article-read",
  (event) => {
    const readArticles =
      event.detail?.readArticles;

    if (Array.isArray(readArticles)) {
      checkCompletion(readArticles);
    } else {
      checkCompletion(getReadArticles());
    }
  }
);
  })();
</script>
